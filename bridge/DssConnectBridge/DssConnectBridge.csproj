<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DssConnectBridge</RootNamespace>
    <AssemblyName>DssConnectBridge</AssemblyName>
    <UserSecretsId>dss-connect-bridge</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact versions, each out for at least two weeks before being used here. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <!-- Pulled in by SqlClient at 9.0.18, which has known vulnerabilities (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7). Requiring the patched .NET 10 version directly overrides it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local settings hold the bridge key; never published from the repo. -->
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.local.json')" />
  </ItemGroup>

</Project>
